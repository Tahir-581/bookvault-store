NEXT_PUBLIC_SUPABASE_URL=https://wksvadcdqgbaadokiaji.supabase.co
# After Supabase Custom Domain is active, prefer:
# NEXT_PUBLIC_SUPABASE_URL=https://auth.ilfaaz.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Same Web client ID as Supabase Auth → Google (public; used by Google Identity Services)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order emails (Nodemailer → Gmail App Password)
EMAIL_USERNAME=
EMAIL_PASSWORD=
OWNER_EMAIL=

# Optional: Gmail OAuth2 / IMAP (not used for send; App Password is used instead)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8085/
GMAIL_TOKEN_FILE=gmail_oauth2_token.json
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
